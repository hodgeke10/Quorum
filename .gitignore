# Secrets — never commit these.
.env

# Local environment and build debris.
.venv/
__pycache__/
*.pyc
.DS_Store

# Every planning run writes a trace here. They are useful while developing and
# meaningless to a reader; the ones the report actually cites are copied into
# output/evidence/ and are committed.
output/traces/

# Saved plans, regenerated by the app.
data/plans/
