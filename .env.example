# Quorum reads the Portkey credential from a .env file in this folder first,
# then from the folder one level above it. Copy this file to .env and fill in
# the value. Never commit a real .env.

PORTKEY_API_KEY=

# Optional override; defaults to https://api.portkey.ai/v1
# PORTKEY_BASE_URL=

# Alternative to Portkey: your own OpenAI key, paid by you.
# OPENAI_API_KEY=
